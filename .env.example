# Salin file ini menjadi .env lalu isi kata sandi sendiri.
# File .env JANGAN di-upload ke GitHub (sudah ada di .gitignore).

# Admin PostgreSQL (dipakai juga untuk metadata Airflow)
PG_ADMIN_USER=db_admin
PG_ADMIN_PASSWORD=ganti_sandi_admin

# Database data warehouse dan user ETL
DW_NAME=fitzone_dw
DW_USER=etl_user
DW_PASSWORD=ganti_sandi_etl

# User baca untuk analis dan dashboard
BI_PASSWORD=ganti_sandi_bi
DASHBOARD_PASSWORD=ganti_sandi_dashboard

# Login web Airflow (http://localhost:8090)
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=ganti_sandi_airflow

# Sumber data
MEMBER_FILE=gym_members_exercise_tracking.csv
# Indikator WHO GHO yang diambil (pisahkan dengan koma)
WHO_INDICATORS=NCD_BMI_30A,NCD_BMI_25A,NCD_BMI_MEAN,NCD_PAA
# Kosong = semua negara. Isi kode negara (misal IDN,MYS,SGP) untuk membatasi.
WHO_COUNTRIES=

# Aturan ETL
REJECT_THRESHOLD=0.05
# Isi 973 saat uji penerimaan agar jumlah baris sumber diperiksa ketat
EXPECTED_MEMBER_ROWS=

# Notifikasi email ETL (opsional; kosongkan SMTP_HOST jika tidak dipakai)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=
